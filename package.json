{
  "name": "outbox-sync",
  "version": "1.0.0",
  "description": "Vendor-agnostic local-first sync engine with outbox pattern and Supabase support",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js",
      "default": "./dist/config/index.js"
    },
    "./supabase": {
      "types": "./dist/adapters/remote/supabase.d.ts",
      "import": "./dist/adapters/remote/supabase.js",
      "default": "./dist/adapters/remote/supabase.js"
    },
    "./expo": {
      "types": "./dist/adapters/local/expo-sqlite.d.ts",
      "import": "./dist/adapters/local/expo-sqlite.js",
      "default": "./dist/adapters/local/expo-sqlite.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node test-runner.mjs",
    "prepublishOnly": "npm run test"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "expo-sqlite": "^57.0.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "expo-sqlite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@types/react": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "expo-sqlite": "^57.0.4",
    "react": "^19.2.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "uuid": "^14.0.3"
  }
}
