{
  "name": "outbox-sync",
  "version": "1.0.0",
  "description": "Vendor-agnostic local-first sync engine with outbox pattern and Supabase support",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js",
      "default": "./dist/config/index.js"
    },
    "./supabase": {
      "types": "./dist/adapters/remote/supabase.d.ts",
      "import": "./dist/adapters/remote/supabase.js",
      "default": "./dist/adapters/remote/supabase.js"
    },
    "./expo-sqlite": {
      "types": "./dist/adapters/local/expo-sqlite.d.ts",
      "import": "./dist/adapters/local/expo-sqlite.js",
      "default": "./dist/adapters/local/expo-sqlite.js"
    },
    "./op-sqlite": {
      "types": "./dist/adapters/local/op-sqlite.d.ts",
      "import": "./dist/adapters/local/op-sqlite.js",
      "default": "./dist/adapters/local/op-sqlite.js"
    },
    "./better-sqlite3": {
      "types": "./dist/adapters/local/better-sqlite3.d.ts",
      "import": "./dist/adapters/local/better-sqlite3.js",
      "default": "./dist/adapters/local/better-sqlite3.js"
    },
    "./libsql": {
      "types": "./dist/adapters/local/libsql.d.ts",
      "import": "./dist/adapters/local/libsql.js",
      "default": "./dist/adapters/local/libsql.js"
    },
    "./sql-js": {
      "types": "./dist/adapters/local/sql-js.d.ts",
      "import": "./dist/adapters/local/sql-js.js",
      "default": "./dist/adapters/local/sql-js.js"
    },
    "./node-sqlite": {
      "types": "./dist/adapters/local/node-sqlite.d.ts",
      "import": "./dist/adapters/local/node-sqlite.js",
      "default": "./dist/adapters/local/node-sqlite.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node test-runner.mjs",
    "prepublishOnly": "npm run test"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "expo-sqlite": "^57.0.0",
    "@op-engineering/op-sqlite": ">=0.1.0",
    "better-sqlite3": ">=8.0.0",
    "@libsql/client": ">=0.6.0",
    "sql.js": ">=1.8.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "expo-sqlite": {
      "optional": true
    },
    "@op-engineering/op-sqlite": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "@libsql/client": {
      "optional": true
    },
    "sql.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@types/react": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "expo-sqlite": "^57.0.4",
    "react": "^19.2.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "uuid": "^14.0.3"
  }
}
