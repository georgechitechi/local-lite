    "lint:fix": "npx node-code-cleaner audit src",
    "lint:package": "publint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:isolate": "vitest run --isolate",
    "test:watch": "vitest",
    "test:package": "node scripts/package-smoke.mjs",
    "prepublishOnly": "npm run lint && npm run test && npm run build && npm run lint:package && npm run test:package"
