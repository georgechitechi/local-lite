{
  "name": "property-admin",
  "main": "expo-router/entry",
  "version": "3.16.12",
  "scripts": {
    "dev": "npx expo start --clear",
    "android": "expo run:android",
    "build:web": "npm version patch && npx expo export --platform web --no-ssg && eas deploy --environment production --prod",
    "lint": "npx @biomejs/biome lint .",
    "format": "npx @biomejs/biome check --write --unsafe . ",
    "format:check": "npx @biomejs/biome format .",
    "check": "npx @biomejs/biome check .",
    "clean": "npx ast-code-cleaner all .",
    "clean:audit": "npx ast-code-cleaner audit .",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage --coverageDirectory=coverage",
    "supabase:generate": "npx supabase gen types typescript --project-id \"pklaiemezeenaywnnfxt\" --schema public > src/shared/types/database.types.ts"
  },
  "dependencies": {
    "@expo/ui": "~57.0.24",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-vector-icons/material-design-icons": "^13.1.4",
    "@supabase/supabase-js": "2.117.2",
    "accesscontrol": "^3.1.1",
    "expo": "~57.0.29",
    "expo-background-task": "~57.0.21",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-contacts": "~57.0.8",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.21",
    "expo-navigation-bar": "~57.0.3",
    "expo-notifications": "~57.0.23",
    "expo-observe": "~57.0.25",
    "expo-pdf-text-extract": "^1.1.0",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.27",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-updates": "~57.0.26",
    "libphonenumber-js": "^1.13.14",
    "local-lite": "^0.0.3",
    "native-android-sms": "^0.2.0",
    "native-in-app-updates": "^0.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "^6.1.6",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.10.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.87.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.4",
    "jest": "^30.5.2",
    "jest-expo": "~57.0.6",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "allowScripts": {
    "core-js@3.49.0": true,
    "esbuild@0.27.0": true,
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "uuid": "$uuid"
  },
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "react-native-webview",
        "@types/jest"
      ]
    }
  }
}
