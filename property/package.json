{
  "name": "property-admin",
  "main": "expo-router/entry",
  "version": "3.16.12",
  "scripts": {
    "dev": "npx expo start --clear",
    "android": "expo run:android",
    "build:web": "npm version patch && npx expo export --platform web --no-ssg && eas deploy --environment production --prod",
    "lint": "npx @biomejs/biome lint .",
    "format": "npx @biomejs/biome check --write --unsafe . ",
    "format:check": "npx @biomejs/biome format .",
    "check": "npx @biomejs/biome check .",
    "clean": "npx ast-code-cleaner all .",
    "clean:audit": "npx ast-code-cleaner audit .",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage --coverageDirectory=coverage",
    "supabase:generate": "npx supabase gen types typescript --project-id \"pklaiemezeenaywnnfxt\" --schema public > src/shared/types/database.types.ts"
  },
  "dependencies": {
    "@expo/ui": "~58.0.20",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-vector-icons/material-design-icons": "^13.1.4",
    "@supabase/supabase-js": "2.117.2",
    "expo": "^58.0.0",
    "expo-background-task": "~58.0.11",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-contacts": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-local-authentication": "~58.0.2",
    "expo-location": "~58.0.17",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.5",
    "expo-observe": "~58.0.15",
    "expo-pdf-text-extract": "^1.1.0",
    "expo-print": "~58.0.6",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "expo-updates": "~58.0.17",
    "libphonenumber-js": "^1.13.14",
    "local-lite": "file:..",
    "native-access-control": "file:../../native-access-control",
    "native-android-sms": "^0.2.0",
    "native-in-app-updates": "^0.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.87.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.4",
    "jest": "^30.5.2",
    "jest-expo": "~57.0.6",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "allowScripts": {
    "core-js@3.49.0": true,
    "esbuild@0.27.0": true,
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "uuid": "$uuid"
  },
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "react-native-webview",
        "@types/jest"
      ]
    }
  }
}
